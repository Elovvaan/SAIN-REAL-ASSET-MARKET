{
  "name": "sain-real-asset-market",
  "version": "1.34.0",
  "private": true,
  "description": "SAIN Real Asset Market persistent onboarding and marketplace read model",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1",
    "test:security": "node --test --test-concurrency=1 tests/operations-authorization.test.mjs",
    "test:transaction-safety": "node --test --test-concurrency=1 tests/transaction-safety.test.mjs",
    "test:settlement": "node --test --test-concurrency=1 tests/verified-settlement.test.mjs",
    "test:runtime": "node --test --test-concurrency=1 tests/production-runtime.test.mjs",
    "test:lifecycle": "node --test --test-concurrency=1 tests/internal-lifecycle-export-boundary.test.mjs",
    "test:products": "node --test --test-concurrency=1 tests/product-qualification.test.mjs",
    "test:production-routing": "node --test --test-concurrency=1 tests/production-readiness-routing.test.mjs",
    "test:admin-agent": "node --test --test-concurrency=1 tests/admin-intelligence-agent.test.mjs",
    "test:platform-asset": "node --test --test-concurrency=1 tests/native-platform-asset.test.mjs",
    "test:admin-platform-asset-ui": "node --test --test-concurrency=1 tests/admin-native-platform-asset-ui.test.mjs",
    "test:financial-history": "node --test --test-concurrency=1 tests/financial-history-service.test.mjs",
    "test:relationships": "node --test --test-concurrency=1 tests/asset-relationship-ledger.test.mjs tests/asset-relationship-router-authorization.test.mjs",
    "test:edx": "node --test --test-concurrency=1 test/edx-pipeline.test.js",
    "test:funding": "node --test --test-concurrency=1 test/funding-engine.integration.test.js",
    "test:load": "node scripts/load-qualification.mjs",
    "backup:create": "node scripts/backup-database.mjs",
    "restore:verify": "node scripts/verify-restore.mjs",
    "test:integration": "npm run test:security && npm run test:transaction-safety && npm run test:settlement && npm run test:runtime && npm run test:lifecycle && npm run test:products && npm run test:production-routing && npm run test:admin-agent && npm run test:platform-asset && npm run test:admin-platform-asset-ui && npm run test:financial-history && npm run test:relationships && node --test --test-concurrency=1 test/edx-pipeline.test.js test/funding-engine.integration.test.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@stellar/stellar-sdk": "15.1.0",
    "ethers": "6.17.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^5.20.0",
    "pg": "^8.13.1",
    "ws": "^8.18.3",
    "xrpl": "5.0.0"
  },
  "devDependencies": { "supertest": "^7.1.4" }
}
